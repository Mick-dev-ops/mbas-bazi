{
  "name": "mbas-bazi",
  "version": "4.0.0",
  "description": "繁體中文 MBAS 八字命盤解讀專家系統",
  "scripts": {
    "dev": "vite --host 0.0.0.0",
    "build": "vite build",
    "preview": "vite preview --host 0.0.0.0",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:dist": "node scripts/verify-dist.mjs",
    "check": "npm test && npm run test:coverage && npm run test:integrity && npm run build && npm run test:dist",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "update:tz": "node scripts/update-timezones.mjs",
    "docs:rules": "node scripts/update-rule-docs.mjs && prettier --write docs/RULES.md",
    "test:integrity": "node scripts/verify-period-coverage.mjs",
    "test:coverage": "node scripts/verify-rule-coverage.mjs"
  },
  "keywords": [],
  "author": "",
  "license": "MIT",
  "type": "module",
  "dependencies": {
    "@fontsource/noto-sans-tc": "^5.3.1",
    "@pdf-lib/fontkit": "^1.1.1",
    "astronomy-engine": "2.1.19",
    "moment-timezone": "0.6.0",
    "pdf-lib": "^1.17.1"
  },
  "devDependencies": {
    "jsdom": "26.1.0",
    "prettier": "3.5.3",
    "vite": "6.4.1",
    "vitest": "3.2.4"
  },
  "private": true,
  "engines": {
    "node": ">=22.12.0"
  }
}
